# Registries (same address on every mainnet)
IDENTITY_REGISTRY=0x8004A169FB4a3325136EB29fA0ceB6D2e539a432
REPUTATION_REGISTRY=0x8004BAa17C55a88189AE136b182e5fdA19dE9b63
VALIDATION_REGISTRY=0x8004Cc8439f36fd5F9F049D9fF86523Df6dAAB58

# Registries (same address on every testnet; not indexed by this repo)
IDENTITY_REGISTRY_TESTNET=0x8004A818BFB912233c491871b3d84c89A494BD9e
REPUTATION_REGISTRY_TESTNET=0x8004B663056A597Dffe9eCcC1965A193B7388713
VALIDATION_REGISTRY_TESTNET=0x8004Cb1BF31DAf7788923b405b754f57acEB4272

# Alchemy. RPC URLs may reference ${ALCHEMY_API_KEY}; the process expands it.
ALCHEMY_API_KEY=
RPC_ETHEREUM=https://eth-mainnet.g.alchemy.com/v2/${ALCHEMY_API_KEY}
RPC_BASE=https://base-mainnet.g.alchemy.com/v2/${ALCHEMY_API_KEY}
RPC_ARBITRUM=https://arb-mainnet.g.alchemy.com/v2/${ALCHEMY_API_KEY}
RPC_OPTIMISM=https://opt-mainnet.g.alchemy.com/v2/${ALCHEMY_API_KEY}
RPC_POLYGON=https://polygon-mainnet.g.alchemy.com/v2/${ALCHEMY_API_KEY}
RPC_BNB=https://bnb-mainnet.g.alchemy.com/v2/${ALCHEMY_API_KEY}
RPC_MONAD=https://monad-mainnet.g.alchemy.com/v2/${ALCHEMY_API_KEY}
RPC_AVALANCHE=
RPC_MANTLE=
RPC_SCROLL=
RPC_GNOSIS=
RPC_CELO=
RPC_LINEA=
RPC_ABSTRACT=
RPC_SONEIUM=
RPC_ROBINHOOD=
RPC_ARC=
RPC_TEMPO=
RPC_SEPOLIA=https://eth-sepolia.g.alchemy.com/v2/${ALCHEMY_API_KEY}
RPC_BASE_SEPOLIA=https://base-sepolia.g.alchemy.com/v2/${ALCHEMY_API_KEY}

# Chunk start. Not the deploy block. `pnpm block-at --chain base --days-ago 14` prints one.
# Deploy blocks live in packages/shared/src/chains.ts. Set START_BLOCK to that value for full history.
START_BLOCK_ETHEREUM=
START_BLOCK_BASE=
START_BLOCK_ARBITRUM=
START_BLOCK_OPTIMISM=
START_BLOCK_POLYGON=
START_BLOCK_BNB=
START_BLOCK_MONAD=
START_BLOCK_AVALANCHE=
START_BLOCK_MANTLE=
START_BLOCK_SCROLL=
START_BLOCK_GNOSIS=
START_BLOCK_CELO=
START_BLOCK_LINEA=
START_BLOCK_ABSTRACT=
START_BLOCK_SONEIUM=
START_BLOCK_ROBINHOOD=
START_BLOCK_ARC=
START_BLOCK_TEMPO=

# The Graph Agent0 subgraphs. Endpoint is built as
# https://gateway.thegraph.com/api/${GRAPH_API_KEY}/subgraphs/id/${SUBGRAPH_ID_<CHAIN>}
GRAPH_API_KEY=
SUBGRAPH_ID_ETHEREUM=
SUBGRAPH_ID_BASE=
SUBGRAPH_ID_POLYGON=
SUBGRAPH_ID_BNB=
SUBGRAPH_ID_MONAD=
SUBGRAPH_ID_ETHEREUM_SEPOLIA=
SUBGRAPH_ID_BASE_SEPOLIA=

IPFS_GATEWAY=https://ipfs.io/ipfs/
FETCH_TIMEOUT_MS=8000

# Contract verification only. Unused by the collectors.
ETHERSCAN_API_KEY=

# Postgres. The connecting role needs CREATEROLE and must own the database.
DATABASE_URL=postgres://merces:password@localhost:5433/merces_data
APP_RO_PASSWORD=change-me

# Unused. Present so a testnet writer key is not required.
PRIVATE_KEY=

# Enabled chains, comma-separated. First run is base only.
CHAINS=base
DATABASE_SCHEMA=erc8004
PONDER_PORT=42069
ALCHEMY_MAX_RPS=20
# Alchemy free tier allows eth_getLogs ranges of 10 blocks. Raise this on a paid plan.
ETH_GET_LOGS_BLOCK_RANGE=10
SUBGRAPH_MIRROR_CHAINS=base
IMPORTER_INTERVAL_SEC=300
ENRICH_CONCURRENCY=5
SCAN8004_BASE_URL=https://api.8004scan.io/api/v1
SCAN8004_API_KEY=
SANITY_SAMPLE=10
OPS_PORT=42070
OPS_USER=admin
OPS_PASSWORD=change-me
METRICS_INTERVAL_SEC=15
