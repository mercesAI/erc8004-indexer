# Registries (same address on every mainnet)
IDENTITY_REGISTRY=0x8004A169FB4a3325136EB29fA0ceB6D2e539a432
REPUTATION_REGISTRY=0x8004BAa17C55a88189AE136b182e5fdA19dE9b63
VALIDATION_REGISTRY=0x8004Cc8439f36fd5F9F049D9fF86523Df6dAAB58

# Registries (same address on every testnet; not indexed by this repo)
IDENTITY_REGISTRY_TESTNET=0x8004A818BFB912233c491871b3d84c89A494BD9e
REPUTATION_REGISTRY_TESTNET=0x8004B663056A597Dffe9eCcC1965A193B7388713
VALIDATION_REGISTRY_TESTNET=0x8004Cb1BF31DAf7788923b405b754f57acEB4272

# Alchemy. RPC URLs may reference ${ALCHEMY_API_KEY}; the process expands it.
ALCHEMY_API_KEY=
RPC_ETHEREUM=https://eth-mainnet.g.alchemy.com/v2/${ALCHEMY_API_KEY}
RPC_BASE=https://base-mainnet.g.alchemy.com/v2/${ALCHEMY_API_KEY}
RPC_ARBITRUM=https://arb-mainnet.g.alchemy.com/v2/${ALCHEMY_API_KEY}
RPC_OPTIMISM=https://opt-mainnet.g.alchemy.com/v2/${ALCHEMY_API_KEY}
RPC_POLYGON=https://polygon-mainnet.g.alchemy.com/v2/${ALCHEMY_API_KEY}
RPC_BNB=https://bnb-mainnet.g.alchemy.com/v2/${ALCHEMY_API_KEY}
RPC_MONAD=https://monad-mainnet.g.alchemy.com/v2/${ALCHEMY_API_KEY}
RPC_AVALANCHE=
RPC_MANTLE=
RPC_SCROLL=
RPC_GNOSIS=
RPC_CELO=
RPC_LINEA=
RPC_ABSTRACT=
RPC_SONEIUM=
RPC_ROBINHOOD=
RPC_ARC=
RPC_TEMPO=
RPC_SEPOLIA=https://eth-sepolia.g.alchemy.com/v2/${ALCHEMY_API_KEY}
RPC_BASE_SEPOLIA=https://base-sepolia.g.alchemy.com/v2/${ALCHEMY_API_KEY}

# First block to index per chain. Empty means full history from the Identity registry's deploy block
# (listed in packages/shared/src/chains.ts). A later block skips older agents for good.
START_BLOCK_ETHEREUM=
START_BLOCK_BASE=
START_BLOCK_ARBITRUM=
START_BLOCK_OPTIMISM=
START_BLOCK_POLYGON=
START_BLOCK_BNB=
START_BLOCK_MONAD=
START_BLOCK_AVALANCHE=
START_BLOCK_MANTLE=
START_BLOCK_SCROLL=
START_BLOCK_GNOSIS=
START_BLOCK_CELO=
START_BLOCK_LINEA=
START_BLOCK_ABSTRACT=
START_BLOCK_SONEIUM=
START_BLOCK_ROBINHOOD=
START_BLOCK_ARC=
START_BLOCK_TEMPO=

# The Graph Agent0 subgraphs. Endpoint is built as
# https://gateway.thegraph.com/api/${GRAPH_API_KEY}/subgraphs/id/${SUBGRAPH_ID_<CHAIN>}
GRAPH_API_KEY=
SUBGRAPH_ID_ETHEREUM=
SUBGRAPH_ID_BASE=
SUBGRAPH_ID_POLYGON=
SUBGRAPH_ID_BNB=
SUBGRAPH_ID_MONAD=
SUBGRAPH_ID_ETHEREUM_SEPOLIA=
SUBGRAPH_ID_BASE_SEPOLIA=

IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs/
FETCH_TIMEOUT_MS=8000

# Contract verification only. Unused by the collectors.
ETHERSCAN_API_KEY=

# Postgres. The connecting role needs CREATEROLE and must own the database.
DATABASE_URL=postgres://merces:password@localhost:5432/merces_data
APP_RO_PASSWORD=change-me

# Unused. Present so a testnet writer key is not required.
PRIVATE_KEY=

# Enabled chains, comma-separated. A new chain starts at its START_BLOCK on the next supervisor start.
CHAINS=base
# How often the indexer polls each chain, in seconds. A cycle is one eth_blockNumber plus one eth_getLogs
# per ETH_GET_LOGS_BLOCK_RANGE new blocks. Per chain: INDEX_INTERVAL_SEC_<CHAIN>.
INDEX_INTERVAL_SEC=300
INDEX_INTERVAL_SEC_MONAD=3600
# Requests per second for the whole indexer process, all chains together.
ALCHEMY_MAX_RPS=20
# Alchemy's free tier allows eth_getLogs ranges of 10 blocks; paid plans allow 2000.
# The indexer halves a range the provider rejects, so a too-large value costs a few retries, not a stall.
ETH_GET_LOGS_BLOCK_RANGE=2000
# Agent0 subgraph mirror, for cross-checks only. Empty means the importer does not start.
SUBGRAPH_MIRROR_CHAINS=
IMPORTER_INTERVAL_SEC=300
# Enrich budget per pass (about once a minute; back to back while a backlog remains).
# Defaults are gentle. A fresh server with hundreds of thousands of files to fetch runs well with
# ENRICH_CONCURRENCY=24 ENRICH_NETWORK_PER_CHAIN=1500 ENRICH_NETWORK_PER_HOST=400 ENRICH_DATA_PER_CHAIN=3000 ENRICH_PASS_LIMIT=5000.
ENRICH_CONCURRENCY=5
ENRICH_NETWORK_PER_CHAIN=40
# Per host within a chain, so one slow platform does not hold a pass open for the others.
ENRICH_NETWORK_PER_HOST=40
ENRICH_DATA_PER_CHAIN=200
ENRICH_PASS_LIMIT=500
# Fetches in flight against one host, so one platform that owns most files is not flooded.
ENRICH_PER_HOST_CONCURRENCY=4
SCAN8004_BASE_URL=https://api.8004scan.io/api/v1
SCAN8004_API_KEY=
SANITY_SAMPLE=10
OPS_PORT=42070
METRICS_INTERVAL_SEC=15
